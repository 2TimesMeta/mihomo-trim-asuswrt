-	off += kipHelloNonceSize
-	copy(h.ServerPub[:], payload[off:off+kipHelloPubSize])
-	off += kipHelloPubSize
-	h.SelectedFeats = binary.BigEndian.Uint32(payload[off : off+4])
-	return &h, nil
-}
