-	buffered := 0
-	if bc.r != nil {
-		buffered = bc.r.Buffered()
-	}
-	if buffered <= 0 {
-		return recorded
-	}
-	peeked, _ := bc.r.Peek(buffered)
-	full := make([]byte, len(recorded)+len(peeked))
