-func (s *Session) sendReset(streamID uint32, msg string) {
-	if msg == "" {
-		msg = "reset"
-	}
-	_ = s.sendFrame(frameReset, streamID, []byte(msg))
-	_ = s.sendFrame(frameClose, streamID, nil)
-}
