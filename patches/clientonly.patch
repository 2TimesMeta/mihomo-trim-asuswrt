-func (p *blockingPermanentPacketIO) WritePacket(context.Context, []byte) error {
-	p.mu.Lock()
-	p.writes++
-	writes := p.writes
-	p.mu.Unlock()
-	if writes == 2 {
-		p.once.Do(func() { close(p.entered) })
-		<-p.release
-		return p.writeErr
-	}
-	return nil
-}
