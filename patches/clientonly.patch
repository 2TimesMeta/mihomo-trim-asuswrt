-func vmessInteropCertChainHash(certContent []byte) string {
-	var hashValue []byte
-	for {
-		block, remain := pem.Decode(certContent)
-		if block == nil {
-			break
-		}
-		certHash := sha256.Sum256(block.Bytes)
