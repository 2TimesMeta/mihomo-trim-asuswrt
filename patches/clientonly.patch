-	c.writeMu.Lock()
-	c.readMu.Lock()
-	defer c.readMu.Unlock()
-	defer c.writeMu.Unlock()
-
-	c.keys = recordKeys{baseSend: cloneBytes(baseSend), baseRecv: cloneBytes(baseRecv)}
