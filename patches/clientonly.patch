-func putHeader(header []byte, frameType byte, streamID uint32, payloadLen int) {
-	header[0] = frameType
-	binary.BigEndian.PutUint32(header[1:5], streamID)
-	binary.BigEndian.PutUint32(header[5:9], uint32(payloadLen))
-}
