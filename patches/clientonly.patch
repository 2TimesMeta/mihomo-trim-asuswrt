-	var err error
-	if len(payload) <= coalesceMaxPayload {
-		err = s.sendQueued(frameType, streamID, payload)
-	} else {
-		err = s.sendDirect(frameType, streamID, payload)
-	}
-	if err != nil {
-		return err
-	}
