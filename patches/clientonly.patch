-	h := sha256.New()
-	_, _ = h.Write([]byte("sudoku-httpmask-auth-v1:"))
-	_, _ = h.Write([]byte(key))
-
-	var sum [32]byte
-	h.Sum(sum[:0])
-
-	return &tunnelAuth{key: sum, skew: skew}
