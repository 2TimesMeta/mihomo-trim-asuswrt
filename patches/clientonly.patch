-	case <-c.closed:
-		return 0, c.closedErr()
-	default:
-	}
-	select {
-	case <-c.writeClosed:
-		return 0, io.ErrClosedPipe
-	default:
-	}
-	select {
-	case c.writeCh <- payload:
-		return len(b), nil
-	case <-c.closed:
-		return 0, c.closedErr()
-	}
-}
-
