-func (c *ControlChannel) readRawControlPacket(ctx context.Context) ([]byte, error) {
-	for {
-		c.mu.Lock()
-		deadline := c.readDeadline
-		if c.readWake == nil {
-			c.readWake = make(chan struct{})
-		}
-		wake := c.readWake
-		c.mu.Unlock()
-
-		opCtx, cancel := context.WithCancel(ctx)
-		deadlineCancel := func() {}
-		if !deadline.IsZero() {
-			opCtx, deadlineCancel = context.WithDeadline(opCtx, deadline)
-		}
-		wakeDone := make(chan struct{})
-		go func() {
-			defer close(wakeDone)
-			select {
-			case <-wake:
-				cancel()
-			case <-opCtx.Done():
-			}
-		}()
-		raw, err := c.io.ReadPacket(opCtx)
-		cancel()
-		deadlineCancel()
-		<-wakeDone
-
-		c.mu.Lock()
-		changed := wake != c.readWake
-		c.mu.Unlock()
-		if err == nil {
-			return raw, nil
-		}
-		if changed && ctx.Err() == nil {
-			continue
-		}
-		return raw, err
-	}
