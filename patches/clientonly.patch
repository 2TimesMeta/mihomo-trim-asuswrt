-func (s *TunnelServer) endSessionPull(token string, sess *tunnelSession, lease *sessionPullLease) {
-	if lease == nil {
-		return
-	}
-	sess.pullMu.Lock()
-	if sess.pull == lease {
-		sess.pull = nil
-	}
-	sess.pullMu.Unlock()
-	close(lease.done)
-}
