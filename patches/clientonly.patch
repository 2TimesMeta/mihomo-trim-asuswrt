-		c.mu.Unlock()
-		return nil
-	default:
-		if err == nil {
-			err = io.ErrClosedPipe
-		}
-		if c.closeErr == nil {
-			c.closeErr = err
-		}
-		close(c.closed)
-	}
-	c.mu.Unlock()
-	return nil
-}
-
-func (c *queuedConn) closedErr() error {
