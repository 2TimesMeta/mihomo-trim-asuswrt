-func appendOpenVPNString(out []byte, s string) []byte {
-	if s == "" {
-		return binary.BigEndian.AppendUint16(out, 0)
-	}
-	if len(s)+1 > 0xffff {
-		s = s[:0xfffe]
-	}
-	out = binary.BigEndian.AppendUint16(out, uint16(len(s)+1))
-	out = append(out, s...)
-	out = append(out, 0)
-	return out
-}
