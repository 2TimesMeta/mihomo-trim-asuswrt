-		return false, 0
-	}
-	if binary.BigEndian.Uint32(packet[:4]) != 0 {
-		return false, 0
-	}
-	if packet[4]&0x0f != KeyMethod2 {
-		return false, 0
-	}
-	offset := 5 + keySourceRandomSize*2
-	if !km2StrComplete(packet, offset) {
-		return false, 0
