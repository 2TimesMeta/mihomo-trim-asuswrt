-
-	var (
-		lastErr error
-		backoff = 50 * time.Millisecond
-	)
-	for attempt := 0; attempt < maxAttempts; attempt++ {
-		req, err := http.NewRequestWithContext(closeCtx, http.MethodPost, controlURL, nil)
-		if err != nil {
-			return err
-		}
-		req.Host = headerHost
