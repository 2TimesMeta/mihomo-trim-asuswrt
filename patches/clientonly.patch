-	if c.method != "none" {
-		if err := validateBaseKey(baseSend); err != nil {
-			return fmt.Errorf("invalid send base key: %w", err)
-		}
-		if err := validateBaseKey(baseRecv); err != nil {
-			return fmt.Errorf("invalid recv base key: %w", err)
