-	// OpenVPN's reliable_ack.lru_acks: acks are copied here when sent and
-	// kept so subsequent control packets repeat them until replaced.
-	lruAcks     []uint32
-	pending     map[uint32]*ControlPacket
-	recvPending map[uint32]*ControlPacket
