-			rBits -= 8
-			p[outN] = byte(rBuf >> rBits)
-			outN++
-			rBuf &= (uint64(1) << rBits) - 1
-		}
-	}
-
-	pc.readBitBuf = rBuf
-	pc.readBits = rBits
-	return outN, consumed, nil
-}
