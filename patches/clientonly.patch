-				pc:      pc,
-				rAddr:   remoteAddr,
-				payload: data,
-				put:     put,
-			}
-			cPacket.rAddr = N.NewCustomAddr(C.TROJAN.String(), connID, cPacket.rAddr) // for tunnel's handleUDPConn
-
-			tunnel.HandleUDPPacket(inbound.NewPacket(target, cPacket, C.TROJAN, additions...))
