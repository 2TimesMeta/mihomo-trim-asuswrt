-func trimASCII(b []byte) string {
-	i := 0
-	j := len(b)
-	for i < j {
-		c := b[i]
-		if c != ' ' && c != '\n' && c != '\r' && c != '\t' {
-			break
-		}
-		i++
-	}
-	for j > i {
-		c := b[j-1]
-		if c != ' ' && c != '\n' && c != '\r' && c != '\t' {
-			break
-		}
-		j--
-	}
-	if i >= j {
-		return ""
-	}
-	out := make([]byte, j-i)
-	copy(out, b[i:j])
-	return string(out)
-}
