-		return Peer{}, fmt.Errorf("invalid uri: %w", err)
-	}
-	if u.RawQuery == "" {
-		return Peer{URI: raw}, nil
-	}
-	kept := make([]string, 0)
-	key := ""
-	stripped := false
-	for _, pair := range strings.Split(u.RawQuery, "&") {
-		if pair == "" {
-			continue
-		}
-		name, value, _ := strings.Cut(pair, "=")
-		decodedName, err := url.PathUnescape(name)
