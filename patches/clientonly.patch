-func (bc *bufferedRecorderConn) GetBufferedAndRecorded() []byte {
-	if bc == nil {
-		return nil
-	}
-	bc.mu.Lock()
-	defer bc.mu.Unlock()
-
-	var recorded []byte
-	if bc.recorder != nil {
-		recorded = bc.recorder.Bytes()
