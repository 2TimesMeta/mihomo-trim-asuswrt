-
-func ParseQUICVersions(values []string) ([]quic.Version, error) {
-	versions := make([]quic.Version, 0, len(values))
-	for _, value := range values {
-		version, err := ParseQUICVersion(value)
-		if err != nil {
-			return nil, err
-		}
