-func (s *Session) sendFrame(frameType byte, streamID uint32, payload []byte) error {
-	if s.IsClosed() {
-		return s.closedErr()
-	}
-	if len(payload) > maxFrameSize {
-		return fmt.Errorf("mux payload too large: %d", len(payload))
-	}
