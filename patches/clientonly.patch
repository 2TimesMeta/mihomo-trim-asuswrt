-func (s *TunnelServer) sessionClose(token string) {
-	s.mu.Lock()
-	sess, ok := s.sessions[token]
-	if ok {
-		delete(s.sessions, token)
-	}
-	s.mu.Unlock()
-	if ok {
-		sess.shutdown()
-	}
-}
